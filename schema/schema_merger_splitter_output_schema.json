{
  "$id": "schema_merger_splitter_output_schema.json",
  "title": "Schema Merger–Splitter Output Schema",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "inputs": {
      "type": "object",
      "description": "The validated input JSON instance used for this module run.",
      "additionalProperties": false,

      "properties": {
        "output_filename": {
          "type": "string"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" }
              },
              "required": ["from", "to"]
            }
          }
        }
      },

      "required": ["output_filename", "sources"]
    },

    "config": {
      "type": "object",
      "description": "Empty configuration object (module has no configuration).",
      "additionalProperties": false,
      "properties": {}
    },

    "results": {
      "type": "object",
      "description": "The results object produced by the module.",
      "additionalProperties": false,

      "properties": {
        "success": { "type": "boolean" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        }
      },

      "required": ["success", "errors"]
    }
  },

  "required": ["inputs", "config", "results"]
}