{
  "$id": "schema_merger_splitter_output_schema.json",
  "title": "Schema‑Merger‑Splitter Output Schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output_filename": {
          "type": "string",
          "description": "File name (not path) where the merged JSON must be written inside the simulators/ directory."
        },
        "sources": {
          "type": "object",
          "description": "Mapping of source filenames to their extraction rules.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "from",
                "to"
              ]
            }
          }
        }
      },
      "required": [
        "output_filename",
        "sources"
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requires_all": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requires_none": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "input_file": {
                "type": "string"
              }
            },
            "required": [
              "requires_all",
              "requires_none",
              "input_file"
            ]
          }
        }
      },
      "required": [
        "runs"
      ]
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "success",
        "errors"
      ]
    }
  },
  "required": [
    "inputs",
    "config",
    "results"
  ]
}